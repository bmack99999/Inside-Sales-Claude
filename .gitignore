# Python
__pycache__/
*.pyc
*.pyo

# Temp Word/Office lock files
~$*

# Claude local machine settings (machine-specific, do not commit)
.claude/settings.local.json

# Salesforce extracted data — regenerated each morning, may contain contact info.
# Ignore the whole directory: the extraction scripts write several files here
# (leads, opportunities, tasks, metrics, commissions) and every run dirtied the
# working tree. The Flask app reads Postgres, not these files, so nothing in the
# deploy depends on them.
dashboard/data/

# Local SQLite database
dashboard/local.db

# Environment variables — contains secrets, never commit
.env
